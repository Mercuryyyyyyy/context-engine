{
  "name": "context",
  "private": true,
  "version": "0.0.0",
  "description": "Context management proxy for AI coding",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @context/engine test",
    "benchmark": "pnpm --filter @context/engine benchmark",
    "demo": "pnpm --filter @context/proxy dev"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
